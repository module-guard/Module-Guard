{
  "name": "moduleguard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "api:generate": "node scripts/api-contract.mjs generate",
    "api:sync": "node scripts/api-contract.mjs sync",
    "api:check": "node scripts/api-contract.mjs check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:demo": "node scripts/demo-timings.mjs --reset && RUN_DEMO=true playwright test e2e/demo.spec.ts --repeat-each=5 --retries=0 && node scripts/demo-timings.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@paper-design/shaders-react": "^0.0.81",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
