NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Enable BOTH only for local demonstration; production defaults disable demo routes/UI.
NEXT_PUBLIC_ENABLE_TEST_UI=false
APP_ENVIRONMENT=production

CORS_ORIGINS=["http://localhost:3000"]

# GitHub login (OAuth App callback: http://localhost:8000/api/auth/github/callback).
# Copy this file to .env and fill these in; .env is never committed.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -hex 32
SESSION_SECRET=
