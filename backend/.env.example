DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/terraform_intelligence
WORKSPACE_ROOT=/tmp/terraform-intelligence
KEEP_SCAN_WORKSPACE=false
CHECKOV_BINARY=.venv-checkov/bin/checkov
CHECKOV_TIMEOUT_SECONDS=300
GIT_TIMEOUT_SECONDS=120
MAX_REPOSITORY_SIZE_MB=200
MAX_PROCESS_OUTPUT_MB=50
SCAN_WORKERS=2
SCAN_QUEUE_SIZE=20
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Static analysis bounds (root + reachable local modules only)
MAX_ANALYSIS_ENTITIES=20000
MAX_ANALYSIS_EDGES=100000
MAX_LOCAL_MODULE_DEPTH=32
MAX_TERRAFORM_FILE_BYTES=2097152

MAX_FLOW_EDGES=100000
MAX_FLOW_PATHS=20
MAX_FLOW_DEPTH=30
MAX_FLOW_SEARCH_STEPS=100000

# Production has no demo route. Enable only for local UI fixture demonstrations.
APP_ENVIRONMENT=production
